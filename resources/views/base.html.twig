<!doctype html>
<html lang="{{ app_locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Tynka's Control Center{% endblock %}</title>

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ appUrl }}/build/assets/css/style.css?v={{ appVersion }}">
    {% endblock %}

    {% block head_meta %}{% endblock %}
</head>
<body>
    {% block body %}{% endblock %}

    {% block javascripts %}{% endblock %}
</body>
</html>
