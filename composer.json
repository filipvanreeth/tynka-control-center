{
  "name": "filipvr/tynka-control-center",
  "description": "Tynka Control Center",
  "autoload": {
    "psr-4": {
      "TynkaControlCenter\\": "src/"
    }
  },
  "require": {
    "ramsey/uuid": "^4.0",
    "php-di/php-di": "^7.0",
    "nikic/fast-route": "^1.3",
    "vlucas/phpdotenv": "^5.6",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "psr/http-server-middleware": "^1.0",
    "twig/twig": "^3.28"
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "phpunit/phpunit": "^12.2",
    "robmorgan/phinx": "^0.16.12"
  },
  "scripts": {
    "php:analyse": [
      "./vendor/bin/phpcs src/ tests/",
      "./vendor/bin/phpstan analyse src/ tests/"
    ],
    "php:fix": [
      "./vendor/bin/phpcbf src/ tests/"
    ]
  }
}
